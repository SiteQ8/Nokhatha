<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget: the season pill, then the next dates, as the web's Today list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
        android:textDirection="rtl"
        android:gravity="start"
            android:id="@+id/brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/kufi_semibold"
            android:textColor="@color/widget_ink"
            android:textSize="17sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/widget_dot"
                android:contentDescription="@null" />
            <TextView
        android:textDirection="rtl"
        android:gravity="start"
                android:id="@+id/season"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plex_semibold"
                android:textColor="@color/widget_ink2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:textDirection="rtl"
        android:gravity="start"
        android:id="@+id/left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:fontFamily="@font/plex_regular"
        android:textColor="@color/widget_ink3"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <TextView
        android:textDirection="rtl"
        android:gravity="start"
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:fontFamily="@font/plex_regular"
        android:textColor="@color/widget_ink2"
        android:textSize="14sp" />
</LinearLayout>
